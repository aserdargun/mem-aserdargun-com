{
  "name": "mem-agent-memory-laboratory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8041 --strictPort",
    "dev:codex": "node scripts/server.mjs start",
    "stop:codex": "node scripts/server.mjs stop",
    "build": "tsc -b && vite build && node scripts/release.mjs && node scripts/verify-artifact.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:codex": "npm run test && npm run build && npm run test:e2e",
    "preview": "vite preview --host 127.0.0.1 --port 8042 --strictPort",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "5.0.1"
  }
}
